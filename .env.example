# 이 파일을 복사해 .env로 저장한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않습니다. 이 예시 파일에는 실제 비밀값을
# 절대 채우지 마세요.

# --- 지식 백엔드 (미설정 시 전부 in-memory로 동작) ---
VECTOR_STORE_BACKEND=memory        # memory | chroma
CHROMA_PERSIST_DIR=./data/chroma
GRAPH_STORE_BACKEND=memory         # memory | kuzu
KUZU_DB_PATH=./data/graph.kuzu
EMBEDDER_BACKEND=hash              # hash(더미) | voyage | gemini
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSION=768         # Matryoshka 축소 차원 (기본 3072 대신 작게)
# 한 번의 API 요청에 몰아 보낼 문서 수 상한 (첫 재색인처럼 한꺼번에 여러
# 문서를 임베딩할 때, 요청 하나가 너무 커서 무료 등급 한도에 걸리는 것을 방지)
GEMINI_EMBED_BATCH_SIZE=10

# --- 임베딩 캐시 (문서 내용이 안 바뀌면 재색인 때 임베딩 API를 다시 안 부름) ---
EMBED_CACHE_PATH=./data/embed_cache.json

# --- 감사 로그 ---
AUDIT_LOG_PATH=./data/audit.jsonl

# --- SSO (미설정 시 서버는 모든 /chat 요청을 501로 거부) ---
# HS256 | RS256
SSO_JWT_ALGORITHM=
# HS256일 때 필수
SSO_JWT_SECRET=
# RS256일 때 필수
SSO_JWT_JWKS_URL=
SSO_JWT_AUDIENCE=
SSO_JWT_ISSUER=

# --- LLM ---
LLM_BACKEND=anthropic              # anthropic | gemini
ANTHROPIC_API_KEY=
# LLM_BACKEND=gemini 또는 EMBEDDER_BACKEND=gemini일 때 필수 (AI Studio에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- 문서 기반 소스 (사규/검토서/FAQ) 로컬 스테이징 디렉터리 ---
# 존재하지 않는 경로를 가리켜도 에러 없이 빈 목록으로 처리됩니다.
REGULATION_DOCS_DIR=./data/raw/regulation
REVIEW_DOCS_DIR=./data/raw/review      # 부서 한정 문서는 하위 폴더로 구분 (data/raw/review/README.md 참고)
FAQ_DOCS_DIR=./data/raw/faq

# --- 크롤러 기반 소스 (법령/유권해석/제재사례) ---
# "패키지.모듈:함수" 형태로 지정하세요. 함수는 인자 없이 list[dict]를 반환해야
# 하며, dict 스키마는 pipeline/connectors/crawler_base.py를 참고하세요.
# 미설정 시 해당 소스는 재색인에서 그냥 제외됩니다(에러 아님).
# 예: crawlers.law_go_kr:crawl_watchlist_items_incremental (법규리스트.xlsx 164개 중 바뀐 것만, 권장) 또는 crawl_watchlist_items(매번 전체) / crawl_law_items(전체 법령)
LAW_CRAWLER=
# crawl_watchlist_items_incremental이 법령별 마지막 공포일자/파싱 결과를 캐시하는 경로
LAW_CRAWL_STATE_PATH=./data/law_crawl_state.json
# 예: my_crawlers.interpretation:crawl_interpretation_items
INTERPRETATION_CRAWLER=
# 예: my_crawlers.case:crawl_case_items
CASE_CRAWLER=

# --- 자동 재색인/동기화 ---
# 서버 시작 시 항상 1회 전체 재색인을 수행합니다. 아래 간격(초)마다 추가로
# 반복 재색인합니다 -- 0이면 시작 시 1회만 수행하고 주기 재색인은 하지 않음.
SYNC_INTERVAL_SECONDS=1800
# 재시작 후에도 "이전엔 있었는데 지금은 사라진 문서" 삭제 감지가 유지되도록
# 소스별 마지막 색인 id 목록을 저장하는 파일 경로.
SYNC_STATE_PATH=./data/sync_state.json
