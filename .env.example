# 이 파일을 복사해 .env로 저장한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않습니다. 이 예시 파일에는 실제 비밀값을
# 절대 채우지 마세요.

# --- 지식 백엔드 (미설정 시 전부 in-memory로 동작) ---
VECTOR_STORE_BACKEND=memory        # memory | chroma
CHROMA_PERSIST_DIR=./data/chroma
GRAPH_STORE_BACKEND=memory         # memory | kuzu
KUZU_DB_PATH=./data/graph.kuzu
EMBEDDER_BACKEND=hash              # hash(더미) | voyage | gemini
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSION=768         # Matryoshka 축소 차원 (기본 3072 대신 작게)
# 한 번의 API 요청에 몰아 보낼 문서 수 상한 (첫 재색인처럼 한꺼번에 여러
# 문서를 임베딩할 때, 요청 하나가 너무 커서 무료 등급 한도에 걸리는 것을 방지)
GEMINI_EMBED_BATCH_SIZE=10
# 분당 쿼터 초과(429) 시 재시도 설정 -- 무료 등급은 분당 한도가 낮아 배치를
# 쉬지 않고 쏘면 몇 초 만에 다 써버릴 수 있다. 유료 플랜으로 넘어가 429가
# 거의 안 난다면 이 값들은 사실상 안 쓰이게 된다(재시도는 429가 났을 때만
# 발동). 재시도를 끄고 싶으면 MAX_RETRIES=1로 설정.
GEMINI_EMBED_RATE_LIMIT_MAX_RETRIES=5
GEMINI_EMBED_RATE_LIMIT_BACKOFF_SECONDS=60

# --- 임베딩 캐시 (문서 내용이 안 바뀌면 재색인 때 임베딩 API를 다시 안 부름) ---
EMBED_CACHE_PATH=./data/embed_cache.json

# --- 감사 로그 ---
AUDIT_LOG_PATH=./data/audit.jsonl

# --- SSO (미설정 시 서버는 모든 /chat 요청을 501로 거부) ---
# HS256 | RS256
SSO_JWT_ALGORITHM=
# HS256일 때 필수
SSO_JWT_SECRET=
# RS256일 때 필수
SSO_JWT_JWKS_URL=
SSO_JWT_AUDIENCE=
SSO_JWT_ISSUER=

# --- 검색 리랭커 ---
# 벡터/BM25는 질의와 문서를 따로 채점하지만, 리랭커는 둘을 함께 읽고 관련성을
# 다시 매겨 후보 20~30개 중 진짜 근거만 남긴다. 정확도 향상 폭이 크지만 질의마다
# 외부 API 호출이 한 번 더 붙어 지연·비용이 늘어나므로 기본값은 none.
# voyage로 켜면 임베딩과 같은 VOYAGE_API_KEY를 쓴다(과금은 별도).
RERANKER_BACKEND=none              # none | voyage
VOYAGE_RERANK_MODEL=rerank-2.5

# --- LLM ---
LLM_BACKEND=anthropic              # anthropic | gemini
ANTHROPIC_API_KEY=
# LLM_BACKEND=gemini 또는 EMBEDDER_BACKEND=gemini일 때 필수 (AI Studio에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 채팅 응답 중 429(쿼터 초과)/503(모델 일시 과부하) 발생 시 재시도 -- 재시도
# 자체를 끄고 싶으면 GEMINI_CHAT_RATE_LIMIT_MAX_RETRIES=1로 설정
GEMINI_CHAT_RATE_LIMIT_MAX_RETRIES=5
GEMINI_CHAT_RATE_LIMIT_BACKOFF_SECONDS=60

# --- 문서 기반 소스 (사규/검토서/FAQ/계약검토 선례) 로컬 스테이징 디렉터리 ---
# 존재하지 않는 경로를 가리켜도 에러 없이 빈 목록으로 처리됩니다.
REGULATION_DOCS_DIR=./data/raw/regulation
REVIEW_DOCS_DIR=./data/raw/review      # 부서 한정 문서는 하위 폴더로 구분 (data/raw/review/README.md 참고)
FAQ_DOCS_DIR=./data/raw/faq
# 준법감시부가 검토·승인을 마친 계약 조항 검토 사례만 올리세요 -- /contract-review가
# 만든 자동 검토 결과를 그대로 넣지 마세요 (data/raw/precedent/README.md 참고)
PRECEDENT_DOCS_DIR=./data/raw/precedent

# --- 크롤러 기반 소스 (법령/유권해석/제재사례) ---
# "패키지.모듈:함수" 형태로 지정하세요. 함수는 인자 없이 list[dict]를 반환해야
# 하며, dict 스키마는 pipeline/connectors/crawler_base.py를 참고하세요.
# 미설정 시 해당 소스는 재색인에서 그냥 제외됩니다(에러 아님).
# 예: crawlers.law_go_kr:crawl_watchlist_items_incremental (법규리스트.xlsx 164개 중 바뀐 것만, 권장) 또는 crawl_watchlist_items(매번 전체) / crawl_law_items(전체 법령)
LAW_CRAWLER=
# crawl_watchlist_items_incremental이 법령별 마지막 공포일자/파싱 결과를 캐시하는 경로
LAW_CRAWL_STATE_PATH=./data/law_crawl_state.json
# 예: my_crawlers.interpretation:crawl_interpretation_items
INTERPRETATION_CRAWLER=
# 예: my_crawlers.case:crawl_case_items
CASE_CRAWLER=

# --- /chat 도구 호출 반복 한도 ---
# 검색-답변 왕복을 최대 몇 번까지 허용할지. 미설정 시 agent.harness의 기본값
# (4)을 그대로 씁니다. 법령→유권해석→제재사례 순으로 여러 번 나눠 검색해야
# 하는 복잡한 질의가 많다면 6~8 정도로 올려보세요 -- /contract-review는
# 이미 8을 쓰고 있어(계약 조항 검토), 같은 값을 chat에도 재사용해도 무방합니다.
# 반복은 순차 LLM 호출이라 값을 올릴수록 최악의 경우 응답 지연·토큰 비용이
# 함께 늘어납니다.
CHAT_MAX_TOOL_ITERATIONS=4

# --- POC 전용 대화형 UI (기본 비활성) ---
# true로 켜면 /poc에서 로그인 화면 없이 바로 질문/답변을 주고받는 로컬 데모
# 페이지가 열립니다. /poc/token이 SSO_JWT_SECRET으로 서명된 토큰을 대신
# 발급해 주는 구조라(make_token.py와 동일한 방식), 이 값이 true인 채로 서버를
# 공유/운영 환경에 올리면 인증 없이 POC_DEPT 권한을 누구나 받아갈 수 있습니다.
# 반드시 로컬 개발 환경에서만 true로 설정하세요. HS256 SSO 설정
# (SSO_JWT_ALGORITHM=HS256, SSO_JWT_SECRET=<임의 문자열>)이 함께 필요합니다.
POC_UI_ENABLED=false
POC_DEPT=compliance

# --- 자동 재색인/동기화 ---
# 서버 시작 시 항상 1회 전체 재색인을 수행합니다. 아래 간격(초)마다 추가로
# 반복 재색인합니다 -- 0이면 시작 시 1회만 수행하고 주기 재색인은 하지 않음.
SYNC_INTERVAL_SECONDS=1800
# 재시작 후에도 "이전엔 있었는데 지금은 사라진 문서" 삭제 감지가 유지되도록
# 소스별 마지막 색인 id 목록을 저장하는 파일 경로.
SYNC_STATE_PATH=./data/sync_state.json
