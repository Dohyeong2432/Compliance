# 이 파일을 복사해 .env로 저장한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않습니다. 이 예시 파일에는 실제 비밀값을
# 절대 채우지 마세요.

# --- 지식 백엔드 (미설정 시 전부 in-memory로 동작) ---
VECTOR_STORE_BACKEND=memory        # memory | chroma
CHROMA_PERSIST_DIR=./data/chroma
GRAPH_STORE_BACKEND=memory         # memory | kuzu
KUZU_DB_PATH=./data/graph.kuzu
EMBEDDER_BACKEND=hash              # hash(더미) | voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- 감사 로그 ---
AUDIT_LOG_PATH=./data/audit.jsonl

# --- SSO (미설정 시 서버는 모든 /chat 요청을 501로 거부) ---
SSO_JWT_ALGORITHM=            # HS256 | RS256
SSO_JWT_SECRET=               # HS256일 때 필수
SSO_JWT_JWKS_URL=             # RS256일 때 필수
SSO_JWT_AUDIENCE=
SSO_JWT_ISSUER=

# --- LLM ---
ANTHROPIC_API_KEY=
